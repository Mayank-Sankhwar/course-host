# PostgreSQL connection string for Prisma commands and the future server data layer.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/busy_course_delivery?schema=public"

# Optional. The server defaults to 3001.
PORT=3001

# A high-entropy secret used to sign session cookies. Generate a different value
# for each environment; never commit the real value.
SESSION_SECRET=""

# Development React origin. Production deployments must set their own HTTPS origin.
CLIENT_ORIGIN="http://localhost:5173"
